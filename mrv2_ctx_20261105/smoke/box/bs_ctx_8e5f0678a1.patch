+def validate_and_normalize_dynamic_sd_context_schedule(
+    num_speculative_tokens_per_batch_size_and_context: object,
+) -> DynamicSDContextSchedule:
+    """Validate and normalize a Dynamic SD batch-size x context schedule.
+
+    Entries are ``(bs_start, bs_end, ctx_start, ctx_end, num_speculative_tokens)``
+    with inclusive ranges. Within each batch-size range the context ranges must
+    start at 1 and be contiguous; the last one extends to any longer context.
+    Returns ``[(bs_start, bs_end, [(ctx_end, K), ...]), ...]`` sorted by batch
+    size, with the last ``ctx_end`` of each range unbounded.
+    """
+    schedule = num_speculative_tokens_per_batch_size_and_context
+    if not isinstance(schedule, list) or not schedule:
+        raise ValueError(
+            "num_speculative_tokens_per_batch_size_and_context must be a non-empty "
+            "list of (bs_start, bs_end, ctx_start, ctx_end, num_speculative_tokens) "
+            "entries."
+        )
+
+    rows: dict[tuple[int, int], list[tuple[int, int, int]]] = {}
+    for entry in schedule:
+        if not isinstance(entry, list | tuple) or len(entry) != 5:
+            raise ValueError(
+                "Each num_speculative_tokens_per_batch_size_and_context entry must "
+                "be a 5-item sequence: (bs_start, bs_end, ctx_start, ctx_end, "
+                "num_speculative_tokens)."
+            )
+        bs_start, bs_end, ctx_start, ctx_end, k = (int(x) for x in entry)
+        if min(bs_start, bs_end, ctx_start, ctx_end) <= 0:
+            raise ValueError(f"Ranges in {tuple(entry)} must be positive.")
+        if bs_start > bs_end or ctx_start > ctx_end:
+            raise ValueError(f"Range start must be <= end in {tuple(entry)}.")
+        if k < 0:
+            raise ValueError(
+                "num_speculative_tokens_per_batch_size_and_context values must be >= 0."
+            )
+        rows.setdefault((bs_start, bs_end), []).append((ctx_start, ctx_end, k))
+
+    normalized: DynamicSDContextSchedule = []
+    previous_end = 0
+    for bs_start, bs_end in sorted(rows):
+        if bs_start <= previous_end:
+            raise ValueError("Batch-size ranges must be non-overlapping and sorted.")
+        previous_end = bs_end
+        ctx_rows = sorted(rows[(bs_start, bs_end)])
+        expected_start = 1
+        for ctx_start, ctx_end, _ in ctx_rows:
+            if ctx_start != expected_start:
+                raise ValueError(
+                    f"Context ranges for batch sizes [{bs_start}, {bs_end}] must "
+                    "start at 1 and be contiguous."
+                )
+            expected_start = ctx_end + 1
+        columns = [(ctx_end, k) for _, ctx_end, k in ctx_rows]
+        columns[-1] = (sys.maxsize, columns[-1][1])
+        normalized.append((bs_start, bs_end, columns))
+
+    if normalized[0][0] != 1:
+        raise ValueError(
+            "The first batch-size range must start at 1 so every runtime "
+            "batch size has a defined schedule."
+        )
+    return normalized
+
+
+class DynamicSDContextLookup:
+    """Dense ``batch_size -> (context bounds, K per context range)`` lookup."""
+
+    def __init__(self, rows: list[tuple[tuple[int, ...], tuple[int, ...]]]):
+        self.rows = rows
+
+    def get(self, batch_size: int, context_len: int) -> int:
+        bounds, ks = self.rows[batch_size]
+        return ks[bisect.bisect_left(bounds, context_len)]
+
+    def options(self, batch_size: int) -> tuple[int, ...]:
+        """Every K the schedule can select at this batch size."""
+        return self.rows[batch_size][1]
+
+
+def build_dynamic_sd_context_lookup(
+    num_speculative_tokens_per_batch_size_and_context: object,
+    vllm_max_batch_size: int,
+    vllm_num_speculative_tokens: int,
+) -> DynamicSDContextLookup:
+    """Expand the batch-size x context schedule into a dense lookup. Batch sizes
+    between or after the configured ranges carry the previous range's row, as
+    `build_dynamic_sd_schedule_lookup` does, and K is clamped to
+    `vllm_num_speculative_tokens`."""
+    if vllm_max_batch_size <= 0:
+        raise ValueError("vllm_max_batch_size must be > 0.")
+    if vllm_num_speculative_tokens <= 0:
+        raise ValueError("vllm_num_speculative_tokens must be > 0.")
+
+    schedule = validate_and_normalize_dynamic_sd_context_schedule(
+        num_speculative_tokens_per_batch_size_and_context
+    )
+    rows: list[tuple[tuple[int, ...], tuple[int, ...]]] = [((), ())] * (
+        vllm_max_batch_size + 1
+    )
+    row: tuple[tuple[int, ...], tuple[int, ...]] = ((), ())
+    next_batch_size = 1
+    for bs_start, bs_end, columns in schedule:
+        if bs_start > vllm_max_batch_size:
+            break
+        for batch_size in range(next_batch_size, bs_start):
+            rows[batch_size] = row
+        row = (
+            tuple(ctx_end for ctx_end, _ in columns),
+            tuple(min(k, vllm_num_speculative_tokens) for _, k in columns),
+        )
+        for batch_size in range(bs_start, min(bs_end, vllm_max_batch_size) + 1):
+            rows[batch_size] = row
+        next_batch_size = bs_end + 1
+    for batch_size in range(next_batch_size, vllm_max_batch_size + 1):
+        rows[batch_size] = row
+    return DynamicSDContextLookup(rows)
+
+
+def dynamic_sd_context_length(requests: Iterable["Request"]) -> int:
+    """The context length a batch looks up its K with: the mean computed tokens
+    of its decoding requests, or of all requests when none is decoding."""
+    computed = [(r.num_computed_tokens, r.num_prompt_tokens) for r in requests]
+    pool = [c for c, prompt in computed if c >= prompt] or [c for c, _ in computed]
+    return sum(pool) // len(pool) if pool else 0
+
+
+def dynamic_sd_k_options(
+    speculative_config: "SpeculativeConfig",
+    vllm_max_batch_size: int,
+    vllm_num_speculative_tokens: int,
+) -> list[tuple[int, ...]]:
+    """Every K the configured schedule can select, per batch size (index 0
+    unused). The scheduler picks from these and graph capture covers them."""
+    if speculative_config.num_speculative_tokens_per_batch_size_and_context:
+        lookup = build_dynamic_sd_context_lookup(
+            speculative_config.num_speculative_tokens_per_batch_size_and_context,
+            vllm_max_batch_size,
+            vllm_num_speculative_tokens,
+        )
+        return [lookup.options(b) for b in range(vllm_max_batch_size + 1)]
+    dense = build_dynamic_sd_schedule_lookup(
+        speculative_config.num_speculative_tokens_per_batch_size,
+        vllm_max_batch_size,
+        vllm_num_speculative_tokens,
+    )
+    return [(k,) for k in dense]
