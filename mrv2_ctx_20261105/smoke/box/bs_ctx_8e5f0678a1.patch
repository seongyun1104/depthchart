+def test_speculator_captures_every_k_of_a_context_schedule(monkeypatch):
+    """With a batch-size x context schedule, draft decode graphs cover every K
+    the schedule can select, as the scheduler reads the same schedule."""
+    monkeypatch.setattr(
+        gpu_cudagraph_utils,
+        "get_pp_group",
+        lambda: SimpleNamespace(is_first_rank=True, is_last_rank=True),
+    )
+    monkeypatch.setattr(
+        gpu_cudagraph_utils.current_platform, "get_global_graph_pool", lambda: object()
+    )
+    monkeypatch.setattr(
+        spec_cudagraph_utils, "prepare_inputs_to_capture", lambda *a, **kw: ({}, {})
+    )
+    forward = MagicMock()
+
+    def capture(manager, create_forward_fn, progress_bar_desc):
+        for desc in manager._capture_descs[CUDAGraphMode.FULL]:
+            create_forward_fn(desc, warmup=False)(CUDAGraphMode.NONE)
+
+    monkeypatch.setattr(gpu_cudagraph_utils.CudaGraphManager, "capture", capture)
+    vllm_config = _create_decode_vllm_config(
+        capture_sizes=[4],
+        num_speculative_tokens=4,
+        dynamic_spec_schedule=[(1, 8, 4)],
+        decode_sizes=[4],
+    )
+    speculative_config = vllm_config.speculative_config
+    speculative_config.num_speculative_tokens_per_batch_size = None
+    speculative_config.num_speculative_tokens_per_batch_size_and_context = [
+        (1, 4, 1, 64, 2),
+        (1, 4, 65, 4096, 4),
+        (5, 8, 1, 64, 0),
+        (5, 8, 65, 4096, 3),
+    ]
+    manager = spec_cudagraph_utils.SpeculatorCudaGraphManager(
+        vllm_config,
+        device=torch.device("cpu"),
+        cudagraph_mode=CUDAGraphMode.FULL_DECODE_ONLY,
+        decode_query_lens={1: 8},
+    )
+    manager.capture(
+        forward,
+        MagicMock(),
+        MagicMock(),
+        MagicMock(),
+        [],
+        MagicMock(),
+        specialize_spec_tokens=True,
+    )
+    assert [c.kwargs["num_speculative_steps"] for c in forward.call_args_list] == [
+        4,
+        3,
+        2,
+    ]
+
+
