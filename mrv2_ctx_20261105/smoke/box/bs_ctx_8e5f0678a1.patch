@@ -245,3 +253,134 @@ def test_scheduler_passes_max_num_seqs_as_dsd_runtime_batch_limit():
     assert len(scheduler.dynamic_sd_lookup) == 17
     assert len(output.num_scheduled_tokens) == 16
     assert output.num_spec_tokens_to_schedule == 3
+
+
+_CTX_SCHEDULE = [
+    (1, 4, 1, 64, 3),
+    (1, 4, 65, 4096, 5),
+    (9, 16, 1, 64, 1),
+    (9, 16, 65, 4096, 2),
+]
+
+
+def test_context_lookup_picks_k_by_context_range():
+    lookup = build_dynamic_sd_context_lookup(
+        _CTX_SCHEDULE, vllm_max_batch_size=32, vllm_num_speculative_tokens=4
+    )
+
+    assert lookup.get(1, 1) == 3
+    assert lookup.get(4, 64) == 3
+    assert lookup.get(4, 65) == 4  # clamped from 5
+    assert lookup.get(4, 10**9) == 4  # the last range is unbounded
+    assert lookup.get(6, 100) == 4  # 5-8 carries the 1-4 row
+    assert lookup.get(32, 64) == 1  # 17-32 carries the 9-16 row
+    assert lookup.get(32, 65) == 2
+    assert lookup.options(4) == (3, 4)
+    assert lookup.options(16) == (1, 2)
+
+
+@pytest.mark.parametrize(
+    "schedule,match",
+    [
+        ([(1, 4, 1, 64)], "5-item sequence"),
+        ([(1, 4, 2, 64, 3)], "start at 1 and be contiguous"),
+        ([(1, 4, 1, 64, 3), (1, 4, 66, 128, 2)], "start at 1 and be contiguous"),
+        ([(1, 4, 1, 64, 3), (4, 8, 1, 64, 2)], "non-overlapping"),
+        ([(2, 4, 1, 64, 3)], "must start at 1"),
+        ([(1, 4, 1, 64, -1)], ">= 0"),
+        ([], "non-empty"),
+    ],
+)
+def test_context_schedule_rejects_invalid_entries(schedule, match):
+    with pytest.raises(ValueError, match=match):
+        build_dynamic_sd_context_lookup(
+            schedule, vllm_max_batch_size=16, vllm_num_speculative_tokens=4
+        )
+
+
+def test_k_options_follow_the_configured_schedule():
+    batch_size_only = SimpleNamespace(
+        num_speculative_tokens_per_batch_size=[(1, 2, 3), (3, 8, 1)],
+        num_speculative_tokens_per_batch_size_and_context=None,
+    )
+    dense = build_dynamic_sd_schedule_lookup(
+        batch_size_only.num_speculative_tokens_per_batch_size, 8, 3
+    )
+    assert dynamic_sd_k_options(batch_size_only, 8, 3) == [(k,) for k in dense]
+
+    with_context = SimpleNamespace(
+        num_speculative_tokens_per_batch_size=None,
+        num_speculative_tokens_per_batch_size_and_context=_CTX_SCHEDULE,
+    )
+    lookup = build_dynamic_sd_context_lookup(_CTX_SCHEDULE, 16, 4)
+    assert dynamic_sd_k_options(with_context, 16, 4)[1:] == [
+        lookup.options(b) for b in range(1, 17)
+    ]
+
+
+def test_decode_query_lens_cover_every_context_range():
+    config = SimpleNamespace(
+        scheduler_config=SimpleNamespace(max_num_seqs=16),
+        num_speculative_tokens=4,
+        speculative_config=SimpleNamespace(
+            uses_dynamic_speculative_decoding=lambda: True,
+            num_speculative_tokens_per_batch_size=None,
+            num_speculative_tokens_per_batch_size_and_context=_CTX_SCHEDULE,
+        ),
+    )
+    # K 3 / 4 up to batch size 8 (1-4 and the carried 5-8), K 1 / 2 up to 16.
+    assert VllmConfig.get_decode_cudagraph_query_lens(config, 5) == {
+        4: 8,
+        5: 8,
+        2: 16,
+        3: 16,
+    }
+
+
+def test_both_schedules_are_rejected():
+    with pytest.raises(ValueError, match="at most one"):
+        SpeculativeConfig(
+            model="ngram",
+            num_speculative_tokens=3,
+            num_speculative_tokens_per_batch_size=[(1, 16, 3)],
+            num_speculative_tokens_per_batch_size_and_context=_CTX_SCHEDULE,
+        )
+
+
+def _decode_step_k(prompt_len: int) -> tuple[int, int]:
+    scheduler = create_scheduler(
+        max_num_seqs=16,
+        max_num_batched_tokens=1024,
+        num_speculative_tokens=4,
+        num_speculative_tokens_per_batch_size_and_context=_CTX_SCHEDULE,
+    )
+    assert scheduler.dynamic_sd_lookup is None
+    assert scheduler.dynamic_sd_context_lookup is not None
+    requests = create_requests(num_requests=2, num_tokens=prompt_len)
+    for request in requests:
+        scheduler.add_request(request)
+    output = scheduler.schedule()
+    req_ids = [r.request_id for r in requests]
+    scheduler.update_from_output(
+        output,
+        ModelRunnerOutput(
+            req_ids=req_ids,
+            req_id_to_index={r: i for i, r in enumerate(req_ids)},
+            sampled_token_ids=[[0], [0]],
+        ),
+    )
+    output = scheduler.schedule()
+    return len(output.num_scheduled_tokens), output.num_spec_tokens_to_schedule
+
+
+def test_scheduler_picks_k_by_context_at_the_same_batch_size():
+    # Decoding requests' computed tokens are their prompts: 10 and 200.
+    assert _decode_step_k(10) == (2, 3)
+    assert _decode_step_k(200) == (2, 4)
+
+
+def test_context_length_uses_decoding_requests_first():
+    decoding = SimpleNamespace(num_computed_tokens=300, num_prompt_tokens=100)
+    prefilling = SimpleNamespace(num_computed_tokens=0, num_prompt_tokens=5000)
+    assert dynamic_sd_context_length([decoding, prefilling]) == 300
+    assert dynamic_sd_context_length([prefilling]) == 0
